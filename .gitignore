# ===== Playwright 持久化浏览器档案 =====
# 有 DISPLAY 时 _launch_browser 走 launch_persistent_context 生成此目录，
# 实测服务器上已 138MB 且持续增长；既会污染 git status 也毫无提交价值。
pw_profile/

# ===== 编辑器 / OS =====
.DS_Store
*.swp

# ===== 项目内 WorkBuddy 记忆目录（非源码）=====
.workbuddy/
